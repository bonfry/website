---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const articles = await getCollection("blog");
// Sort by date descending
articles.sort((a, b) => b.data.publish_date.valueOf() - a.data.publish_date.valueOf());
---

<Layout title="Talks" description="Talks and presentations.">
    <div class="section-title with-line">Talks</div>
    <div class="main-text">
        <ul class="talks-list">
            {
                articles.map((article) => (
                    <li>
                        <a href={`/blog/${article.id}`} class="talk-card">
                            <div class="talk-card-title">{article.data.title}</div>
                            <p class="talk-card-desc">{article.data.subtitle}</p>
                            <div class="talk-card-date">
                                Published at: {article.data.publish_date.toLocaleDateString('en-US', {
                                    year: "numeric",
                                    month: "long",
                                    day: "numeric",
                                })}
                            </div>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</Layout>
